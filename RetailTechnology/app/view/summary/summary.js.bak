        summary.find('#construction-calls').prop('href', "https://irbpartners.sharepoint.com/sites/RetailTechDeployment/Lists/Construction%20Calls/DispForm.aspx?ID=" + store.ConstructionId);
        summary.find('#combined-schedule').prop('href', "https://irbpartners.sharepoint.com/sites/RetailTechDeployment/Lists/Combined%20Schedule/DispForm.aspx?ID=" + store.CombinedId);
        summary.find('#master-portal').prop('href', "https://www.sonicpartnernet.com/public/master%20portal/store.aspx?store=" + store.StoreNumber);

